{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "prHourlyLimit": 5,
  "flux": {
    "managerFilePatterns": ["kubernetes/**/*.yaml", "kubernetes/**/*.yml"]
  },
  "kubernetes": {
    "managerFilePatterns": ["kubernetes/**/*.yaml", "kubernetes/**/*.yml"]
  },
  "packageRules": [
    {
      "matchManagers": ["custom.jsonata"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql", "ghcr.io/tensorchord/cloudnative-vectorchord"],
      "pinDigests": true
    },
    {
      "matchManagers": ["custom.jsonata"],
      "matchPackageNames": ["ghcr.io/tensorchord/cloudnative-vectorchord"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$"
    },
    {
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["**/gotk-components.yaml"],
      "enabled": false
    },
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["git-refs"],
      "matchFileNames": ["kubernetes/clusters/*/*.yaml"],
      "enabled": false
    },
    {
      "matchCurrentVersion": "/-(alpha|beta|rc|pre)/",
      "automerge": false
    },
    {
      "matchManagers": ["custom.jsonata"],
      "matchPackageNames": ["siderolabs/talos"],
      "ignoreUnstable": false,
      "allowedVersions": "/^v?[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$/"
    },
    {
      "matchManagers": ["custom.jsonata"],
      "matchFileNames": ["cluster-versions.json"],
      "groupName": "talos + kubernetes",
      "separateMultipleMinor": true
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["kubernetes/**/*.yaml", "kubernetes/**/*.yml"],
      "matchStrings": [
        "$[apiVersion = 'postgresql.cnpg.io/v1' and kind = 'Cluster' and $exists(spec.imageName)].($image := $split(spec.imageName, '@'); {'depName': $substringBefore($image[0], ':'), 'currentValue': $substringAfter($image[0], ':'), 'currentDigest': $image[1]})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["kubernetes/clusters/*/*.yaml"],
      "matchStrings": [
        "$[kind = 'GitRepository' and $exists(spec.ref.tag)].{'depName': $substringBefore($substringAfter(spec.url, 'https://github.com/'), '.git'), 'currentValue': spec.ref.tag, 'currentDigest': spec.ref.commit}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["cluster-versions.json"],
      "matchStrings": ["{'depName': 'siderolabs/talos', 'currentValue': talos}"],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["cluster-versions.json"],
      "matchStrings": ["{'depName': 'siderolabs/kubelet', 'currentValue': kubernetes}"],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/siderolabs/kubelet",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/renovate.yml"],
      "matchStrings": ["renovate-version: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    }
  ]
}
